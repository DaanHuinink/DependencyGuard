<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The CLI loads projects the way the build does (MSBuild through Roslyn's workspace), which needs the .NET 10
         SDK's MSBuild and a compiler that knows its C#. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dependency-guard</ToolCommandName>
    <PackageId>DependencyGuard.Cli</PackageId>
    <Version>0.2.0-beta.3</Version>
    <Authors>Daan Huinink</Authors>
    <Description>CLI for DependencyGuard: check namespace-level dependency rules or generate an initial rule set from a project or solution.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DependencyGuard.Analyzer\DependencyGuard.Analyzer.csproj" />
    <ProjectReference Include="..\DependencyGuard.Core\DependencyGuard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
  </ItemGroup>

</Project>
