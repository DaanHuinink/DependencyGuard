<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>RS2008</NoWarn>

    <PackageId>DependencyGuard.Analyzer</PackageId>
    <Version>0.1.0</Version>
    <Authors>Daan Huinink</Authors>
    <Description>
      A Roslyn analyzer that enforces namespace-level dependency rules in C# projects.
      Define allowed and denied dependencies in a YAML configuration file and get build errors when architectural boundaries are crossed.
    </Description>
    <PackageTags>roslyn;analyzer;architecture;dependencies;namespace</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\DependencyGuard.Analyzer.props" Pack="true" PackagePath="build" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DependencyGuard.Core\DependencyGuard.Core.csproj" />
  </ItemGroup>

  <Target Name="AddAnalyzerToPackage" AfterTargets="Build">
    <ItemGroup>
      <None Include="$(TargetDir)DependencyGuard.Analyzer.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="$(TargetDir)DependencyGuard.Core.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="$(TargetDir)YamlDotNet.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
