<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- A package of its own, so a test can check what a rule file allows (DependencyGuardFactory). -->
    <PackageId>DependencyGuard.Core</PackageId>
    <Version>0.2.0-beta.1</Version>
    <Authors>Daan Huinink</Authors>
    <Description>
      The rules engine of DependencyGuard: read a dependency-guard.yaml and ask whether one namespace may depend on another.
      Use it to test that a rule file says what the architecture says; the analyzer checks the code.
    </Description>
    <PackageTags>architecture;dependencies;namespace</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DependencyGuard.Tests.Core" />
  </ItemGroup>

</Project>
