<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Every demo build restores a new dev version of the analyzer: keep them out of the machine's package cache. -->
    <add key="globalPackagesFolder" value="../LocalPackages/Cache" />
  </config>
  <packageSources>
    <add key="local" value="../LocalPackages" />
  </packageSources>
</configuration>
